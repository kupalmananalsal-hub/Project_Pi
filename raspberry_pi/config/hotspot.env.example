# Copy to /etc/project-pi/hotspot.env (install_headless.sh does this automatically).
PROJECT_PI_HOTSPOT_SSID=Teddy
PROJECT_PI_HOTSPOT_PASSWORD=your-hotspot-password
PROJECT_PI_HOTSPOT_CONNECTION=Teddy
PROJECT_PI_HOTSPOT_STATIC_IPV4=10.129.205.32/24
# Leave blank to auto-detect from the current default route.
PROJECT_PI_HOTSPOT_STATIC_GATEWAY=
PROJECT_PI_HOTSPOT_STATIC_DNS="8.8.8.8 8.8.4.4"

# API security — set a strong random token and match it in the Flutter app.
# Generate one with: python3 -c "import secrets; print(secrets.token_hex(32))"
# If left as the default ("project-pi-local-token"), any device on the hotspot
# can call control endpoints (shutdown, reboot, refresh, deploy). Change this.
PROJECT_PI_API_TOKEN=project-pi-local-token

# Comma-separated HTTP origins allowed by CORS. Leave blank for localhost-only.
# For a Flutter app on a physical device, Android/iOS native HTTP does not use
# browser CORS, so this only matters for web builds.
PROJECT_PI_CORS_ORIGINS=http://localhost,http://127.0.0.1
