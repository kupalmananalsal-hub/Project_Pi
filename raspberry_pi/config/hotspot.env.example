# /etc/project-pi/hotspot.env, written only by `install_headless.sh --apply --configure-hotspot`.
# The boot script touches NetworkManager ONLY when PROJECT_PI_FORCE_HOTSPOT=1; without it,
# it logs the current SSID/IPv4 and changes nothing.
PROJECT_PI_FORCE_HOTSPOT=1
PROJECT_PI_HOTSPOT_SSID=Teddy
PROJECT_PI_HOTSPOT_PASSWORD=your-hotspot-password
PROJECT_PI_HOTSPOT_CONNECTION=Teddy
PROJECT_PI_HOTSPOT_STATIC_IPV4=10.129.205.32/24
# Leave blank to auto-detect from the current default route.
PROJECT_PI_HOTSPOT_STATIC_GATEWAY=
PROJECT_PI_HOTSPOT_STATIC_DNS="8.8.8.8 8.8.4.4"

# API authentication is NOT configured here. It is optional and off by default;
# install_headless.sh creates /etc/project-pi/backend.env (root-only) with
# instructions for turning it on.
