[Unit]
Description=Project Pi Vosk, Snowboy, and openWakeWord alert service
After=sound.target network-online.target project-pi-boot.service thermal-backend.service
Wants=network-online.target thermal-backend.service
StartLimitIntervalSec=120
StartLimitBurst=10

[Service]
Type=simple
User=thesis
Group=audio
SupplementaryGroups=gpio i2c spi
WorkingDirectory=/home/thesis/Project_Pi
Environment=PYTHONUNBUFFERED=1
Environment=VOSK_MODEL_PATH=/home/thesis/vosk-models/vosk-model-tl-ph-generic-0.6
Environment=BACKEND_ALERT_URL=http://127.0.0.1:8765/api/alerts
Environment=ALERT_QUEUE_PATH=/tmp/project_pi_alerts.jsonl
Environment=PROJECT_PI_AUDIO_STATUS_PATH=/tmp/project_pi_audio_status.json
Environment=MIC_NAME_HINT=seeed
Environment=VOSK_KEYWORD_CONFIDENCE=0.60
Environment=KWS_CHANNELS=2
Environment=KWS_CHUNK_FRAMES=1280
Environment=NOISE_GATE_THRESHOLD=0.015
Environment=NOISE_GATE_HOLD_MS=220
Environment=NOISE_SUPPRESSOR_STRENGTH=0.60
Environment=NOISE_PROFILE_SECONDS=2.0
Environment=NOISE_PROFILE_ADAPT_RATE=0.05
Environment=NOISE_LOG_INTERVAL_SECONDS=5.0
Environment=OPENWAKEWORD_ENABLED=1
Environment="OPENWAKEWORD_MODELS=/home/thesis/Project_Pi/raspberry_pi/kws/openwakeword_models/tulong.tflite,/home/thesis/Project_Pi/raspberry_pi/kws/openwakeword_models/help.tflite"
Environment=OPENWAKEWORD_VAD_THRESHOLD=0.50
Environment=OPENWAKEWORD_WAKE_THRESHOLD=0.50
Environment=OPENWAKEWORD_SPEEX_NOISE_SUPPRESSION=1
Environment=DIRECTION_THRESHOLD_SECONDS=0.00003
Environment=SNOWBOY_SWIG_PATH=/home/thesis/snowboy/swig/Python3
Environment=SNOWBOY_EXAMPLES_PATH=/home/thesis/snowboy/examples/Python3
Environment=SNOWBOY_RESOURCE_PATH=/home/thesis/snowboy/examples/Python3/resources/common.res
Environment=SNOWBOY_MODEL_PATHS=/home/thesis/snowboy/examples/Python3/resources/models/help.pmdl
Environment=SNOWBOY_KEYWORDS=help
Environment=SNOWBOY_ALERT_KEYWORD=help
Environment=SNOWBOY_SENSITIVITY=0.40
Environment=SNOWBOY_SENSITIVITY_QUIET=0.50
Environment=SNOWBOY_SENSITIVITY_MODERATE=0.40
Environment=SNOWBOY_SENSITIVITY_NOISY=0.32
Environment=SNOWBOY_AUDIO_GAIN=1.0
Environment=SNOWBOY_CONFIDENCE=0.95
Environment=SNOWBOY_HELP_CONFIRM_SECONDS=1.2
Environment=SNOWBOY_SUPPRESS_AFTER_TULONG_SECONDS=2.2
Environment=KWS_COOLDOWN_SECONDS=2.0
Environment=KWS_DEBUG=0
ExecStart=/home/thesis/kws-env/bin/python /home/thesis/Project_Pi/raspberry_pi/kws/kws_alert_dual.py
Restart=always
RestartSec=3
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target project-pi.target
