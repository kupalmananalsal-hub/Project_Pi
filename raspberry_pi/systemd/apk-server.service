[Unit]
Description=Serve Project Pi Flutter APK over HTTP
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=thesis
WorkingDirectory=/home/thesis/Project_Pi
ExecStart=/usr/bin/python3 -m http.server 8080 --directory /home/thesis/Project_Pi/build/app/outputs/flutter-apk/
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
