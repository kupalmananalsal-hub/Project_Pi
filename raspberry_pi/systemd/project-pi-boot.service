[Unit]
Description=Project Pi headless boot preparation (hotspot, units, apt, logs)
After=NetworkManager-wait-online.service network-online.target
Wants=network-online.target
# Do not stop/restart app units here; they start via multi-user.target after this oneshot.

[Service]
Type=oneshot
User=root
RemainAfterExit=yes
# Root-owned copy installed by install_headless.sh; never run the thesis-writable repo copy as root.
ExecStart=/usr/local/sbin/project-pi-boot
TimeoutStartSec=600

[Install]
WantedBy=multi-user.target
