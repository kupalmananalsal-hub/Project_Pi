[Unit]
Description=Project Pi thermal/audio FastAPI backend
After=network-online.target sound.target project-pi-boot.service
Wants=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=10

[Service]
Type=simple
User=thesis
Group=audio
SupplementaryGroups=gpio i2c spi
WorkingDirectory=/home/thesis/Project_Pi/raspberry_pi/backend
# Created by install_headless.sh: API auth mode/token (off by default) and the caregiver
# credentials path. "-": a missing file means no-token mode, not a unit that cannot start.
EnvironmentFile=-/etc/project-pi/backend.env
StateDirectory=project-pi/backend
StateDirectoryMode=0700
Environment=PYTHONUNBUFFERED=1
# 2 Hz is the safe MLX90640 rate for the 110-degree BAA variant; raise only for BAB.
Environment=THERMAL_REFRESH_HZ=2
Environment="GPIOZERO_PIN_FACTORY=lgpio"
Environment="DATASET_DIR=/home/thesis/Project_Pi/dataset"
Environment="THERMAL_HUMAN_MODEL_PATH=/home/thesis/Project_Pi/dataset/thermal/models/thermal_human_shape.tflite"
Environment="THERMAL_HUMAN_MODEL_METADATA_PATH=/home/thesis/Project_Pi/dataset/thermal/models/thermal_human_shape_labels.json"
Environment="THERMAL_HUMAN_MODEL_THRESHOLD=0.65"
# Optional troubleshooting override: Environment="LGPIO_CHIP=<chip-number>"
# Runs as thesis, not root (+): root must never execute thesis-writable files.
# "-": if the patch needs root-owned site-packages it fails, but the patch already
# on disk stays in effect and the backend still starts.
ExecStartPre=-/home/thesis/thermal-env-sys/bin/python /home/thesis/Project_Pi/raspberry_pi/scripts/patch_blinka_lgpio_pin.py
ExecStart=/home/thesis/thermal-env-sys/bin/uvicorn main:app --host 0.0.0.0 --port 8765
Restart=always
RestartSec=3
TimeoutStopSec=20
KillMode=control-group

[Install]
WantedBy=multi-user.target project-pi.target
