# Allow thesis to restart Project Pi services and power the Pi off without a password.
# Only root-owned commands belong here: a script under /home/thesis could be edited by
# thesis (or the backend running as thesis) to run anything as root.
# `""` means "no arguments allowed"; without it sudo accepts any arguments.
Defaults:thesis !requiretty
thesis ALL=(root) NOPASSWD: /usr/local/sbin/project-pi-refresh "", /usr/local/sbin/project-pi-refresh --restart-backend
thesis ALL=(root) NOPASSWD: /usr/bin/systemctl restart kws-alert.service
thesis ALL=(root) NOPASSWD: /usr/bin/systemctl restart thermal-backend.service
thesis ALL=(root) NOPASSWD: /usr/bin/systemctl restart apk-server.service
thesis ALL=(root) NOPASSWD: /usr/sbin/shutdown -h now, /usr/sbin/reboot, /sbin/shutdown -h now, /sbin/reboot, /usr/bin/systemctl poweroff, /usr/bin/systemctl reboot
